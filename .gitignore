# Build artifacts — regenerate with `pebble build`
build/

# JS dependencies — regenerate with `npm install`
node_modules/

# macOS metadata
.DS_Store
**/.DS_Store

# Pebble emulator lock files
.lock-waf_*
.wafpickle-*

# Secrets / env files
.env
.env.*
*.env.local

# Proxy key — never commit (template: src/pkjs/secrets.js.example)
src/pkjs/secrets.js

# Screenshots from local testing
/screenshot*.png
/shot*.png

# Working emulator captures. Only the curated set the README embeds is
# tracked — everything else is a throwaway from a layout/font/platform sweep
# and goes stale the moment the face changes. Keep them locally, not in git.
screenshots/**/*.png
!screenshots/readme/*.png
screenshots/platform-review/
